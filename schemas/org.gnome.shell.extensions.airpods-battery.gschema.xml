<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="airpods-battery">
  <schema id="org.gnome.shell.extensions.airpods-battery" path="/org/gnome/shell/extensions/airpods-battery/">
    <key name="panel-position" type="s">
      <choices>
        <choice value="left"/>
        <choice value="right"/>
      </choices>
      <default>'right'</default>
      <summary>Panel position</summary>
      <description>Place the indicator on the left or right side of the top panel.</description>
    </key>
    <key name="panel-display" type="s">
      <default>'both'</default>
      <summary>Panel display mode</summary>
      <description>Show both batteries, the lowest battery, or the icon only.</description>
    </key>
    <key name="hide-when-disconnected" type="b">
      <default>true</default>
      <summary>Hide when disconnected</summary>
    </key>
    <key name="show-case-battery-in-panel" type="b">
      <default>true</default>
      <summary>Show case battery in the panel</summary>
      <description>Show the charging case icon and battery percentage beside the AirPods levels.</description>
    </key>
    <key name="stale-timeout-minutes" type="u">
      <default>15</default>
      <range min="5" max="60"/>
      <summary>Battery data stale timeout</summary>
    </key>
  </schema>
</schemalist>
